# OpenAI API Key (erforderlich)
OPENAI_API_KEY=sk-...

# Optional: OpenAI-kompatibles Gateway statt api.openai.com (z. B. Hochschul-Hub)
# OPENAI_BASE_URL=https://hub.ki.fh-swf.de/v1

# Optional: Modelle überschreiben (Defaults siehe config.py)
# Hinweis: bei manchen Gateways (z. B. LiteLLM-Proxys) brauchen Modell-IDs ein
# Provider-Prefix, z. B. "openai/gpt-4o-mini" statt "gpt-4o-mini".
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: Chunking-Parameter überschreiben
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# Optional: Retrieval-Parameter überschreiben
# RETRIEVAL_K=5

# Optional: Mistral-API-Key für den LLM-Vergleich im Frontend
# (kostenloser Tier: https://console.mistral.ai/)
# Ohne diesen Key ist die Mistral-Option im Frontend deaktiviert.
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-small-latest
