# OpenAI API Key (erforderlich)
OPENAI_API_KEY=sk-...

# Optional: OpenAI-kompatibles Gateway statt api.openai.com (z. B. Hochschul-Hub)
# OPENAI_BASE_URL=https://hub.ki.fh-swf.de/v1

# Optional: Modelle überschreiben (Defaults siehe config.py)
# Hinweis: bei manchen Gateways (z. B. LiteLLM-Proxys) brauchen Modell-IDs ein
# Provider-Prefix, z. B. "openai/gpt-4o-mini" statt "gpt-4o-mini".
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: volles gpt-4o überschreiben (läuft über denselben Key/Hub wie
# oben; Antwort-LLM-Variante im LLM-Vergleich und Best-of-Breed-Pipeline,
# siehe docs/LLM.md)
# GPT4O_MODEL=gpt-4o

# Optional: Chunking-Parameter überschreiben
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150

# Optional: Retrieval-Parameter überschreiben
# RETRIEVAL_K=5
# RETRIEVAL_FETCH_K=20

# Optional: Netzwerk-Robustheit (Timeout/Retries) für alle OpenAI-/Mistral-
# API-Clients (LLMs, Embeddings) überschreiben - zentral statt an einzelnen
# Stellen dupliziert, siehe config.py.
# API_REQUEST_TIMEOUT=60
# API_MAX_RETRIES=2

# Optional: Mistral-API-Key für den Antwort- oder Zweitrichter-LLM in den
# Vergleichsstudien (kostenloser Tier: https://console.mistral.ai/) - nicht
# für die Chat-App selbst nötig, siehe docs/LLM.md, docs/BEST_OF_BREED.md.
# Ohne diesen Key laufen die betroffenen scripts/evaluate_*.py-Aufrufe mit
# Mistral nicht.
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=mistral-small-latest

# Anthropic-API-Key für den RAGAS-Richter (siehe eval/metrics.py).
# Erforderlich für scripts/evaluate_*_ragas.py; ohne diesen Key schlägt
# der Judge-Aufbau fehl. Claude bewertet bewusst nur als unabhängiger
# Richter, nicht als Antwort-LLM-Kandidat.
# ANTHROPIC_API_KEY=sk-ant-...
# JUDGE_MODEL=claude-sonnet-5
